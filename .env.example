# Copy this file to ".env.development" (for "npm run dev") and fill in your own values.
# For a production build, set the same variable in your host (for example Vercel → Environment Variables).
# Never commit the real env files (they are in .gitignore).
#
# Vite only gives the app variables that start with "VITE_", and everyone can see
# them in the browser. Never put a secret here.

# The backend address (no "/" at the end).
# Local: http://localhost:5000   Phone on the same Wi-Fi: http://<your-PC-IP>:5000
VITE_API_URL=http://localhost:5000
